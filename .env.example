# database (Neon PostgreSQL pooled & direct connection strings)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# gemini
GEMINI_API_KEY=

# flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# session
SESSION_SECRET=

# app
NEXT_PUBLIC_APP_URL=

# email transport selector ('resend' or 'smtp', defaults to 'resend')
EMAIL_TRANSPORT=

# email: resend (when EMAIL_TRANSPORT=resend)
RESEND_API_KEY=
RESEND_FROM=

# email: smtp (when EMAIL_TRANSPORT=smtp, e.g. local Gmail development)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# development stubs (local development only: 'true' or 'false')
NEXT_PUBLIC_ENABLE_DEV_STUBS=
