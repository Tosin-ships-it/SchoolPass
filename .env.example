# database
DATABASE_URL=

# gemini
GEMINI_API_KEY=

# flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# session
SESSION_SECRET=

# app
NEXT_PUBLIC_APP_URL=

# email (transport selector: 'smtp' or 'resend', defaults to 'resend')
# EMAIL_TRANSPORT=smtp

# email: resend (when EMAIL_TRANSPORT=resend)
RESEND_API_KEY=
# RESEND_FROM=SchoolPass <onboarding@resend.dev>

# email: smtp (when EMAIL_TRANSPORT=smtp, e.g. local Gmail development)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-schoolpass-account@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=SchoolPass <your-schoolpass-account@gmail.com>

# development stubs (local development only)
# NEXT_PUBLIC_ENABLE_DEV_STUBS=true
