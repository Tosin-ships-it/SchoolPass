// SchoolPass Prisma Schema
// Single-School Architecture (PRD v6.0 & Addendum v6.1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ==========================================
// 1. IDENTITY & AUTHENTICATION (STAGE 1)
// ==========================================

enum StaffRole {
  STAFF
  ADMIN
}

model Parent {
  id                     String          @id @default(cuid())
  name                   String
  email                  String          @unique
  passwordHash           String
  previousPasswordHashes String[]        @default([]) // Prevents reuse of last 3 passwords (PRD §8.2, §17)
  emailVerifiedAt        DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  students               ParentStudent[]
  payments               Payment[]
  arrivalConfirmations   ArrivalConfirmation[]
  aiUsageDaily           AiUsageDaily[]

  @@map("parents")
}

model StaffUser {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         StaffRole     @default(STAFF)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  feeEntries        FeeEntry[]
  attendanceRecords AttendanceRecord[]

  @@map("staff_users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "parent" | "staff" | "admin"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model RateLimit {
  key          String    @id // Account or IP identifier
  attempts     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("rate_limits")
}

// ==========================================
// 2. STUDENTS & GUARDIAN LINKS
// ==========================================

model Student {
  id        String    @id @default(cuid())
  name      String
  className String
  leftAt    DateTime? // Leaver marker (Addendum §9.6): parent access terminates if non-null
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guardians            ParentStudent[]
  attendanceRecords    AttendanceRecord[]
  arrivalConfirmations ArrivalConfirmation[]
  feeEntries           FeeEntry[]
  payments             Payment[]

  @@map("students")
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_students")
}

// ==========================================
// 3. SCHOOL
// ==========================================

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arrivalConfirmations ArrivalConfirmation[]

  @@map("schools")
}

// ==========================================
// 4. ATTENDANCE & ARRIVAL CONFIRMATION
// ==========================================

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum AttendanceSource {
  STAFF
  PARENT_CONFIRMATION
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  studentId         String
  date              DateTime
  time              DateTime?
  status            AttendanceStatus
  source            AttendanceSource
  recordedByStaffId String?
  createdAt         DateTime         @default(now())

  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedByStaff   StaffUser?       @relation(fields: [recordedByStaffId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([recordedByStaffId])
  @@map("attendance_records")
}

enum ArrivalMethod {
  QR
  MANUAL_CODE
}

enum ArrivalStatus {
  CONFIRMED
}

model ArrivalConfirmation {
  id        String        @id @default(cuid())
  studentId String
  parentId  String
  schoolId  String
  date      DateTime
  time      DateTime
  method    ArrivalMethod
  status    ArrivalStatus
  createdAt DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([parentId])
  @@index([schoolId])
  @@map("arrival_confirmations")
}

model ArrivalCode {
  id          String   @id @default(cuid())
  date        DateTime @unique
  qrTokenHash String
  manualCode  String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@map("arrival_codes")
}

// ==========================================
// 5. FEES & PAYMENTS
// ==========================================

enum FeeEntryType {
  CHARGE
  ADJUSTMENT
  OFFLINE_PAYMENT
}

model FeeEntry {
  id               String       @id @default(cuid())
  studentId        String
  termId           String
  type             FeeEntryType
  amount           Decimal      @db.Decimal(12, 2)
  note             String?
  createdByStaffId String
  createdAt        DateTime     @default(now())

  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdByStaff   StaffUser    @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)

  @@index([studentId, termId])
  @@index([createdByStaffId])
  @@map("fee_entries")
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model Payment {
  id                   String        @id @default(cuid())
  studentId            String
  parentId             String
  amount               Decimal       @db.Decimal(12, 2)
  internalReference    String        @unique
  flutterwaveReference String?       @unique
  status               PaymentStatus
  createdAt            DateTime      @default(now())
  verifiedAt           DateTime?

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([studentId])
  @@index([parentId])
  @@index([status])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  CONFIRMED
}

model Refund {
  id        String       @id @default(cuid())
  paymentId String
  amount    Decimal      @db.Decimal(12, 2)
  status    RefundStatus
  createdAt DateTime     @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

// ==========================================
// 6. APPROVED SCHOOL INFO & AI GOVERNANCE
// ==========================================

model ApprovedSchoolInfo {
  id        String   @id @default(cuid())
  category  String
  title     String
  content   String
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Strict architectural boundary: No foreign keys to students, parents, fees, or attendance
  @@index([category])
  @@map("approved_school_info")
}

enum ReportStatus {
  OPEN
  REVIEWED
}

enum ReportReason {
  WRONG
  OUTDATED
  NO_ANSWER
  OTHER
}

model AnswerReport {
  id           String       @id @default(cuid())
  question     String
  answer       String
  reason       ReportReason
  note         String?
  fingerprint  String       @unique
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  reviewedById String?
  reviewedAt   DateTime?

  @@index([status])
  @@map("answer_reports")
}

model AiUsageDaily {
  id            String   @id @default(cuid())
  parentId      String
  date          DateTime
  questionCount Int      @default(0)

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, date])
  @@index([parentId])
  @@map("ai_usage_daily")
}

model AiStatsDaily {
  id           String   @id @default(cuid())
  date         DateTime @unique
  answered     Int      @default(0)
  notFound     Int      @default(0)
  unavailable  Int      @default(0)
  limitReached Int      @default(0)
  reported     Int      @default(0)

  @@map("ai_stats_daily")
}

// ==========================================
// 7. SCHOOL SETTINGS & CONFIGURATION
// ==========================================

model SchoolSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("school_settings")
}
